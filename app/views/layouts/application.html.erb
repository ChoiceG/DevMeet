<!DOCTYPE html>
<html>

<head>
    <title><%= content_for(:title) || "Dev Meet" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="preconnect" href="http://fonts.googleapis.com">
    <link rel="preconnect" href="http://fonts.gstatic.com" crossorigin>
    <link href="http://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%#= javascript_include_tag "https://js.stripe.com/v3/", type: 'text/javascript' %>
    <script src="https://js.stripe.com/v3/"></script>
    <%= javascript_importmap_tags %>
    <%= tag :meta, :name => "stripe-key", :content => STRIPE_PUBLIC_KEY %>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">
            <%= link_to root_path , class: 'navbar-brand' do %>
            <i class="fa-solid fa-user-group"></i>
            DevMatch
            <% end %>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">

                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <%= link_to "About" , about_path , class: 'nav-link active' %>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <%= link_to "Contact Us" , new_contact_path , class: 'nav-link active' %>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <% if user_signed_in? %>
                        <%= button_to "Log Out",  destroy_user_session_path, class: "btn btn-outline-light navbar-btn", method: :delete %>
                        <% else %>
                        <%= link_to "Log In", new_user_session_path, class: "btn btn-outline-light navbar-btn" %>
                        <% end %> </li>
                </ul>
            </div>
        </div>
    </nav>
    <%= yield %>

</body>

</html>